# 9router / OpenAI-compatible configuration
LLM_BASE_URL=https://api.9router.com/v1
LLM_API_KEY=your_api_key_here
LLM_MODEL=gpt-4o-mini

# Speech-to-Text Model (PhoWhisper)
WHISPER_MODEL=diepho/PhoWhisper-small-ct2

# PostgreSQL Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/signbridge


# Nạp PhoWhisper lúc khởi động (0 = nạp ở request STT đầu tiên)
WHISPER_PRELOAD=1

# /api/sign: confidence >= ngưỡng thì mobile phát loa luôn; timeout gọi LLM vision (giây)
SIGN_CONFIDENCE_THRESHOLD=0.7
AI_TIMEOUT_SIGN=6

# /api/sign/glosses (luồng Hybrid, mobile nhận diện offline)
# Nhãn model TFLite; không có file → chỉ chấp nhận bộ ký hiệu mục 7
VSL_LABELS_PATH=data/vsl/labels.json
# Xác suất tối thiểu của từng ký hiệu; thấp hơn → UNKNOWN + thẻ gợi ý
VSL_MIN_GLOSS_CONFIDENCE=0.7
AI_TIMEOUT_GLOSSES=4
