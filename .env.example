# 9router / OpenAI-compatible configuration
LLM_BASE_URL=https://api.9router.com/v1
LLM_API_KEY=your_api_key_here
LLM_MODEL=gpt-4o-mini

# Speech-to-Text Model (PhoWhisper)
WHISPER_MODEL=diepho/PhoWhisper-small-ct2

# PostgreSQL Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/signbridge

